{
  "rules": {
    "jq": {
      "rooms": {
        "$room": {
          ".read": "auth != null",
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['v', 'ch']) && newData.child('ch').isNumber() && (!newData.child('nick').exists() || (newData.child('nick').isString() && newData.child('nick').val().length <= 12))"
            }
          }
        }
      },
      "queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['v'])"
        }
      }
    }
  }
}
