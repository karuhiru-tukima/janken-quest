{
  "rules": {
    "jq": {
      "rooms": {
        "$room": {
          ".read": "auth != null",
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['v', 'ch']) && newData.child('ch').isNumber() && (!newData.child('nick').exists() || (newData.child('nick').isString() && newData.child('nick').val().length <= 12))"
            }
          }
        }
      },
      "queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['v'])"
        }
      },
      "tower": {
        ".read": "auth != null",
        ".indexOn": [
          "f"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'f', 't']) && (!data.exists() || newData.child('f').val() >= data.child('f').val()) && ((!data.exists() || newData.child('f').val() > data.child('f').val()) ? newData.child('t').val() === now : newData.child('t').val() === data.child('t').val())",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "f": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999 && newData.val() % 1 === 0"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['data', 'updatedAt'])",
          "data": {
            "jq-progress": {
              ".validate": "newData.isString() && newData.val().length <= 64000"
            },
            "jq-cards": {
              ".validate": "newData.isString() && newData.val().length <= 1048576"
            },
            "jq-resume": {
              ".validate": "newData.isString() && newData.val().length <= 262144"
            },
            "jq-home-kaede": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "jq-sort": {
              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "jq-nick": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "jq-profile": {
              ".validate": "newData.isString() && newData.val().length <= 4096"
            },
            "jq-tower": {
              ".validate": "newData.isString() && newData.val().length <= 16384"
            },
            "$other": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
